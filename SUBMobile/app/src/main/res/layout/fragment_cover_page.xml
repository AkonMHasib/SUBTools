<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- STAGE 1: INFO FILLING -->
            <LinearLayout
                android:id="@+id/layout_stage_1_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Stage Indicator Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP 1 OF 2  •  INFORMATION"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fill Assignment Info"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"
                    android:text="Enter your course, assignment details, and teacher information."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="@color/card_light"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <!-- Subject Selection -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Enrolled Subject"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_subjects"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_spinner_container" />

                        <!-- Course Teacher -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_layout_teacher"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:hint="Course Faculty Name"
                            app:boxStrokeColor="@color/primary"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:hintTextColor="@color/text_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_teacher"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine|textCapWords"
                                android:maxLines="4"
                                android:minLines="1"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Assignment Title -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_layout_title"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:hint="Assignment Title / Topic"
                            app:boxStrokeColor="@color/primary"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:hintTextColor="@color/text_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_assignment_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Assignment Number -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_layout_num"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:hint="Assignment No (e.g. 01)"
                            app:boxStrokeColor="@color/primary"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:hintTextColor="@color/text_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_assignment_num"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Assessment Type Dropdown -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assessment Type"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_exam_type"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_spinner_container" />

                        <!-- Submission Date -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_layout_date"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:hint="Submission Date"
                            app:boxStrokeColor="@color/primary"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="1.5dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:hintTextColor="@color/text_hint">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_submission_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="true"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Stage 1 Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_next_to_templates"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:backgroundTint="@color/primary"
                            android:text="Next: Choose Template  →"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:strokeWidth="0dp"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- STAGE 2: TEMPLATE CHOOSING -->
            <LinearLayout
                android:id="@+id/layout_stage_2_templates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Stage 2 Header Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back_to_info"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Edit Information"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:layout_marginBottom="4dp" />

                <!-- Stage Indicator Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP 2 OF 2  •  TEMPLATE &amp; STYLE"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Cover Template"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"
                    android:text="Choose from modern Canvas or pixel-perfect HTML cover page layouts."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="@color/card_light"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Template Selection Dropdown -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Template Style"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_templates"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_spinner_container" />

                        <!-- Font Family Dropdown -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Font Family"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinner_fonts"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/bg_spinner_container" />

                        <!-- Generate PDF Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_generate_pdf"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:backgroundTint="@color/primary"
                            android:text="⚡  Generate Cover Page PDF"
                            android:textColor="@color/text_on_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            app:strokeWidth="0dp"
                            app:cornerRadius="14dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
