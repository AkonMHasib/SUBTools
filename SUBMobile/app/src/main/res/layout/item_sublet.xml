<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card_shadow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Type Pill Badge & Rent Tag -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal">

                <!-- Type Badge -->
                <TextView
                    android:id="@+id/textTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🛋️ Seat"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Gender Preference Badge -->
                <TextView
                    android:id="@+id/textGenderBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_blue"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="👨 Male Only"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Approval Status Badge (For user's own items) -->
                <TextView
                    android:id="@+id/textApprovalBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_priority_badge"
                    android:backgroundTint="#FEF3C7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="⏳ Pending Admin Review"
                    android:textColor="#D97706"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Rent Tag -->
            <TextView
                android:id="@+id/textRentPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="৳ 3,500 / mo"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Room/Seat Photo Preview -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imagePhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/ic_room" />

        <!-- Title -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="1 Master Bed Seat Available in 3-Bed Flat"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Location & Available Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Dhanmondi 27 (Near Main Campus)"
                android:textColor="@color/text_secondary_light"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAvailableDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 From Aug 1"
                android:textColor="@color/text_secondary_light"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bills Included Flag & Address -->
        <TextView
            android:id="@+id/textBillsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚡ Bills: Included (Gas, Water, Wi-Fi)"
            android:textColor="#059669"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/textDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Attached bath, balcony, 24/7 generator backup, non-smoker preferred."
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp" />

        <!-- Host Info & Contact Actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <!-- Host Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textHostName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Posted by: Akon (CSE)"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textContactPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="📞 01700000000"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Contact Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkBooked"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="Mark Booked"
                    android:textColor="#E11D48"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:strokeColor="#E11D48"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallHost"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="12dp"
                    android:text="Call"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#4ADE80"
                    android:paddingHorizontal="12dp"
                    android:text="WhatsApp"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
