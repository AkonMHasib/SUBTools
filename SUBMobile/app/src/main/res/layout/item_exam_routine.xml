<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Course & Exam Type Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_exam_course_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSE-311"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_exam_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Midterm"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary_light" />
        </RelativeLayout>

        <!-- Course Title -->
        <TextView
            android:id="@+id/txt_exam_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Database Management Systems"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="10dp" />

        <!-- Details Grid: Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_exam_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 2026-10-15"
                    android:textColor="@color/text_primary_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_exam_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ 10:00 AM - 12:00 PM"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Room Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/txt_exam_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room 504"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Invigilator & Instructions -->
        <TextView
            android:id="@+id/txt_exam_invigilator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invigilator: Dr. Jane Doe"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
