<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <ScrollView
        android:id="@+id/scroll_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants"
            android:gravity="center_horizontal">

            <!-- Profile Avatar Section -->
            <FrameLayout
                android:id="@+id/layout_avatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile_avatar"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="47dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_light">

                    <ImageView
                        android:id="@+id/img_profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_myplaces" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile_avatar_placeholder"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="47dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/txt_profile_avatar_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/text_on_primary"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:text="S" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Camera Edit Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_edit_badge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/text_on_primary"
                        android:contentDescription="Edit Avatar" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:id="@+id/text_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_gravatar_instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Card 1: Academic Info -->
            <FrameLayout
                android:id="@+id/card_profile_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_shadow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓 ACADEMIC IDENTITY"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Name -->
                    <TextView
                        android:id="@+id/txt_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Student Name"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Student Badges Row matching Web Portal -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/layout_badges_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp">

                        <!-- Role Badge (Student / Student + Admin / Admin) -->
                        <TextView
                            android:id="@+id/badge_role"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_role"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="STUDENT"
                            android:textColor="@color/badge_role_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Department Badge -->
                        <TextView
                            android:id="@+id/badge_department"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_dept"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="CSE"
                            android:textColor="@color/badge_dept_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Academic Term Badge -->
                        <TextView
                            android:id="@+id/badge_term"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_term"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Semester 1"
                            android:textColor="@color/badge_term_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Batch Badge -->
                        <TextView
                            android:id="@+id/badge_batch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_batch"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Batch 59"
                            android:textColor="@color/badge_batch_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Section Badge -->
                        <TextView
                            android:id="@+id/badge_section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_section"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Section: All"
                            android:textColor="@color/badge_section_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Hidden legacy badges for viewbinding compatibility -->
                    <LinearLayout
                        android:id="@+id/layout_student_id_row"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">
                        <TextView android:id="@+id/txt_student_id" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextView android:id="@+id/txt_profile_section" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <!-- Email Row -->
                    <TextView
                        android:id="@+id/txt_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="6dp"
                        android:text="student@sub.edu.bd"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_light" />

                    <!-- Separate Profile Blocks: Department & Batch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEPARTMENT"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_profile_department"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Computer Science &amp; Engineering"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BATCH"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_profile_batch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Batch 53"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Academic System & Term Type Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACADEMIC SYSTEM"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_profile_term_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Semester System"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACADEMIC TERM"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_profile_current_term_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Semester 1"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Backward compatibility view -->
                    <TextView
                        android:id="@+id/txt_academic_status"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_light" />

                    <!-- Edit: Section & Term -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️ EDIT SECTION &amp; TERM"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SECTION"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_section"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_container" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACADEMIC TERM"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_term"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_container" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_academic"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/primary"
                        android:text="Save Section &amp; Term"
                        android:textColor="@color/text_on_primary"
                        android:textStyle="bold"
                        app:strokeColor="@color/border_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 2: Personal & Contact Info -->
            <FrameLayout
                android:id="@+id/card_personal_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_shadow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 CONTACT &amp; PERSONAL DETAILS"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Phone & DOB Row (DOB is Locked / Read-Only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PHONE NUMBER"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edit_profile_phone"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_container"
                                android:hint="01XXXXXXXXX"
                                android:inputType="phone"
                                android:paddingHorizontal="12dp"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DATE OF BIRTH (LOCKED 🔒)"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <!-- Locked DOB Field -->
                            <TextView
                                android:id="@+id/edit_profile_dob"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_container"
                                android:gravity="center_vertical"
                                android:hint="DD/MM/YYYY"
                                android:paddingHorizontal="12dp"
                                android:textColor="@color/text_hint_light"
                                android:textSize="13.5sp"
                                android:clickable="false"
                                android:focusable="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Blood Group & Donor Status (Blood Group is Locked / Read-Only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLOOD GROUP (LOCKED 🔒)"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <!-- Locked Blood Group View -->
                            <TextView
                                android:id="@+id/txt_locked_blood_group"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_container"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:text="O+"
                                android:textColor="@color/text_hint_light"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <!-- Hidden spinner for binding compatibility if needed -->
                            <Spinner
                                android:id="@+id/spinner_blood_group"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLOOD DONOR STATUS"
                                android:textColor="@color/text_hint_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_blood_donor"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:text="Available"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Location / Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="LOCATION / ADDRESS"
                        android:textColor="@color/text_hint_light"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_profile_location"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_container"
                        android:hint="e.g. Dhanmondi, Dhaka"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- Save Personal Details Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_personal"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/primary"
                        android:text="Save Personal Details"
                        android:textColor="@color/text_on_primary"
                        android:textStyle="bold"
                        app:strokeColor="@color/border_light"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="8dp" />

                    <!-- Legacy views hidden for compatibility -->
                    <TextView android:id="@+id/txt_profile_phone" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txt_profile_dob" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txt_profile_blood_group" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txt_profile_blood_donor" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txt_profile_location" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Save Profile Button (Hidden) -->
            <Button
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Sign Out Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="Sign Out"
                android:textColor="#E11D48"
                android:textStyle="bold"
                app:strokeColor="#E11D48"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/primary" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
