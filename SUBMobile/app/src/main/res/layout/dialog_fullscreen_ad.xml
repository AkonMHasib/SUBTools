<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000">

    <!-- Ad Container Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_ad_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_dark">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Main Ad Banner Image -->
            <ImageView
                android:id="@+id/img_fullscreen_ad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Sponsored Ad" />

            <!-- Progress / Loading Spinner -->
            <ProgressBar
                android:id="@+id/progress_ad_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/primary" />

            <!-- Top Skip Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:padding="12dp">

                <TextView
                    android:id="@+id/btn_skip_ad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skip ✕"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#88000000"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Bottom Learn More CTA Bar -->
            <LinearLayout
                android:id="@+id/layout_ad_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#AA000000"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sponsored Announcement"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_ad_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Link ↗"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
