<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Padded Top Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- Header Section with Bus Name, Plate No., and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bs_bus_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Madhobilota"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bs_bus_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DM-SA-11-0722"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Close Button at top-right -->
            <ImageView
                android:id="@+id/btn_close_sheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_primary"
                android:contentDescription="Close Panel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/bs_route_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gazipur Route (R-GAZ)"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/border_light"
            android:layout_marginVertical="12dp" />

        <!-- Route Stoppages -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPLETE ROUTE (ORDERED STOPS)"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bs_route_stops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mirpur 10 • Mirpur 1 • Kalyanpur • Campus"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- Live GPS Tracking Section -->
    <LinearLayout
        android:id="@+id/bs_tracking_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIVE GPS TRACKING MAP"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp" />

            <TextView
                android:id="@+id/btn_open_external_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open in Browser ↗"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <WebView
            android:id="@+id/bs_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0dp" />

    </LinearLayout>

</LinearLayout>
