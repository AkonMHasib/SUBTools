<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Subject Code & Department -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_slide_subject_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSE-221"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary_light" />

            <TextView
                android:id="@+id/txt_slide_dept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="CSE"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Slide Title -->
        <TextView
            android:id="@+id/txt_slide_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chapter 4: Memory Management &amp; Paging"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Lecture Number / Topic Tag -->
        <TextView
            android:id="@+id/txt_slide_lecture_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lecture 05"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Optional Description -->
        <TextView
            android:id="@+id/txt_slide_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detailed lecture slides covering virtual memory, paging tables, and TLB cache."
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="10dp" />

        <!-- Footer Action: Download Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_slide_uploader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Uploaded by Faculty"
                android:textColor="@color/text_secondary_light"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_download_slide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Download 📥"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="@color/primary"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
