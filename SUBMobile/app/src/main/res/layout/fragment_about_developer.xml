<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. DEVELOPER PROFILE CARD matching StudentAbout.jsx -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_developer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_light"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/border_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <!-- Avatar with Gradient Ring Effect -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        app:cardCornerRadius="52dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="2.5dp"
                        app:strokeColor="@color/primary"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/img_dev"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_dev_akon"
                            android:contentDescription="Akon M Hasib" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Developer Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Akon M Hasib"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <!-- Department -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Department of Architecture"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <!-- Institution -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State University of Bangladesh (SUB)"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:background="@color/border_light"
                        android:layout_marginVertical="14dp" />

                    <!-- Bio -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="An architecture student passionate about software design, full-stack systems, and user-centric optimization workflows. Built SUBTools from scratch to make academic life simpler, transparent, and seamlessly automated for all State University of Bangladesh students."
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Social / Contact Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Facebook Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_facebook"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:text="FB"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#1877F2"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_facebook"
                            app:iconTint="@color/white"
                            app:iconSize="14dp"
                            app:iconPadding="4dp" />

                        <!-- LinkedIn Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_linkedin"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:text="LinkedIn"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#0A66C2"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_linkedin"
                            app:iconTint="@color/white"
                            app:iconSize="14dp"
                            app:iconPadding="4dp" />

                        <!-- WhatsApp Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_whatsapp"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:text="WhatsApp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#25D366"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconTint="@color/white"
                            app:iconSize="14dp"
                            app:iconPadding="4dp" />

                        <!-- Email Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_email"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:text="Email"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/bg_light"
                            app:strokeColor="@color/border_light"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_email"
                            app:iconTint="#E11D48"
                            app:iconSize="14dp"
                            app:iconPadding="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. OFFICIAL FACEBOOK GROUP & COMMUNITY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_community_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Official Student Community"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_blue"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Join the SUBTools Facebook Group"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Need help? Found a bug? Have feature requests or suggestions? Share your feedback with other students and the development team directly in our community!"
                        android:textColor="#DDEEFE"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_join_fb_group"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Join Facebook Group"
                        android:textColor="#0077B6"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_facebook"
                        app:iconTint="#1877F2"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. STUDENT WELLBEING & SUPPORT (Need to Talk shortcut) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wellbeing_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_light"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#FECDD3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_heart"
                            app:tint="#E11D48"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STUDENT WELLBEING &amp; SUPPORT"
                            android:textColor="#E11D48"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_blue"
                            android:backgroundTint="#FFE4E6"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Need to Talk? We're Here For You"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="University life can be overwhelming at times. Whether you are dealing with academic stress, exam anxiety, or personal hardships, you don't have to carry it all alone."
                        android:textColor="@color/text_secondary_light"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_messenger"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Messenger"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#2563EB"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_facebook"
                            app:iconTint="@color/white"
                            app:iconSize="14dp"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_call_helpline"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Call 16665"
                            android:textColor="#065F46"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#ECFDF5"
                            app:strokeColor="#A7F3D0"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_phone"
                            app:iconTint="#059669"
                            app:iconSize="14dp"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. PLATFORM ARCHITECTURE SPECS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_light"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/border_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="About SUBTools Platform"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SUBTools is an integrated academic companion engineered specifically for students, faculty, and administration of State University Bangladesh."
                        android:textColor="@color/text_secondary_light"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Spec 1: Version -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_badge_blue"
                            android:backgroundTint="@color/bg_light"
                            android:padding="10dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VERSION"
                                android:textColor="@color/text_hint"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_spec_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="v3.0.0"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Spec 2: Backend -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_badge_emerald"
                            android:backgroundTint="#ECFDF5"
                            android:padding="10dp"
                            android:layout_marginHorizontal="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BACKEND"
                                android:textColor="#059669"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Supabase"
                                android:textColor="#065F46"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Spec 3: Client -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_badge_purple"
                            android:backgroundTint="#F5F3FF"
                            android:padding="10dp"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CLIENT"
                                android:textColor="#7C3AED"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Native Android"
                                android:textColor="#5B21B6"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
