<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_shadow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Blood Group Bubble (circular badge) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_blood_group"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_light"
            app:cardBackgroundColor="@color/priority_critical"
            android:layout_marginEnd="16dp"
            android:layout_gravity="center_vertical">
            
            <TextView
                android:id="@+id/txt_blood_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="O+"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Information details & Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Donor Name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txt_dept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dept. of Architecture"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txt_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dhaka, Dhanmondi"
                android:textColor="@color/text_secondary_light"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

            <!-- Email Row: icon + full email address -->
            <LinearLayout
                android:id="@+id/btn_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/nav_drawer_item_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/text_secondary_light"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Email" />

                <TextView
                    android:id="@+id/txt_email_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="donor@sub.edu.bd"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="none"
                    android:singleLine="false"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light"
                android:layout_marginVertical="10dp" />

            <!-- Phone Actions Row -->
            <LinearLayout
                android:id="@+id/layout_phone_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Call Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Call"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_phone"
                    app:iconSize="14dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp" />

                <!-- WhatsApp Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_whatsapp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="WhatsApp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconSize="14dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
