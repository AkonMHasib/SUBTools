<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/img_contact_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_phone"
        app:tint="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/txt_contact_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Landphone"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/img_contact_icon"
        app:layout_constraintEnd_toStartOf="@id/btn_action"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_contact_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="+880258151782-4"
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/txt_contact_label"
        app:layout_constraintEnd_toEndOf="@id/txt_contact_label"
        app:layout_constraintTop_toBottomOf="@id/txt_contact_label" />

    <TextView
        android:id="@+id/txt_contact_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Admission Office"
        android:textColor="@color/text_secondary_light"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/txt_contact_label"
        app:layout_constraintEnd_toEndOf="@id/txt_contact_label"
        app:layout_constraintTop_toBottomOf="@id/txt_contact_value" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action"
        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:icon="@drawable/ic_phone"
        app:iconSize="16dp"
        app:iconTint="@color/text_on_primary"
        app:backgroundTint="@color/primary"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1.5dp"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
