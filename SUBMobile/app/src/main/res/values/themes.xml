<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme: Electric Campus (Neo-Clean Expressive) -->
    <style name="Theme.SUBTools" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary_variant</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>

        <!-- Window background and bar styling -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/card_light</item>
        
        <!-- Typography styling -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        
        <!-- Global Component Styles (Neo-Clean 16dp corners & 1dp subtle stroke) -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FAB</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>

        <!-- Embedded Dropdown & Spinner System -->
        <item name="spinnerStyle">@style/Widget.App.Spinner</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.App.DropDownItem</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoCompleteTextView</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopupWindow</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="editTextStyle">@style/Widget.App.EditText</item>
        
        <!-- Ripple effect color -->
        <item name="colorControlHighlight">@color/primary_light</item>
    </style>

    <!-- Smooth Rounded Corner Size Specifications -->
    <style name="ShapeAppearance.Brutalist" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.App.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Material Design 3 Modern Component Styles (Strict 0dp elevation / no shadows) -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cardBackgroundColor">@color/card_light</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">999dp</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/card_light</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>

    <style name="Widget.App.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">#FFFFFF</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@color/card_light</item>
        <item name="itemIconTint">@color/primary</item>
    </style>

    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Embedded Dropdown Components -->
    <style name="Widget.App.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:dropDownSelector">@drawable/bg_dropdown_item_selector</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="Widget.App.DropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:background">@drawable/bg_dropdown_item_selector</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="Widget.App.AutoCompleteTextView" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:dropDownSelector">@drawable/bg_dropdown_item_selector</item>
    </style>

    <style name="Widget.App.ListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:dropDownSelector">@drawable/bg_dropdown_item_selector</item>
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card</item>
        <item name="backgroundTint">@color/card_light</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card</item>
        <item name="backgroundTint">@color/card_light</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>
    
    <style name="ShapeAppearanceOverlay.App.CornerSize8dp" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>
    
    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Theme.SUBTools.Light" parent="Theme.SUBTools" />
</resources>