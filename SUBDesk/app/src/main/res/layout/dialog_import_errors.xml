<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvErrorHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post-Import Error Breakdown"
        android:textColor="@color/rose_500"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="The following row items were skipped due to validation errors or duplicate slot conflicts:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_input"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvErrorDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseErrors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="Close Breakdown" />

</LinearLayout>
