<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvDetailNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notice Title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Author / Date Metadata -->
        <TextView
            android:id="@+id/tvDetailAuthorDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Posted by Coordinator | 28/07/2026"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- Status & Department Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_live"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LIVE"
                android:textColor="@color/emerald_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDeptBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_role_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="CSE"
                android:textColor="@color/primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/border_light" />

        <!-- Full Content -->
        <TextView
            android:id="@+id/tvDetailFullDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Full notice content details go here..."
            android:textColor="@color/text_primary"
            android:textSize="14.5sp" />

        <!-- Image Attachment Preview -->
        <ImageView
            android:id="@+id/ivDetailNoticeImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="14dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@color/bg_light" />

        <!-- PDF Attachment Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailViewPdf"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="📄 View PDF Document (Drive / OneDrive)"
            android:textColor="@color/rose_500"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/rose_100" />

        <!-- Super Admin Action Buttons (Hidden for non-super-admins) -->
        <LinearLayout
            android:id="@+id/layoutSuperAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailEdit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailArchive"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Archive"
                android:textColor="@color/emerald_500"
                android:textSize="12sp"
                app:backgroundTint="@color/emerald_100" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Delete"
                android:textColor="@color/rose_500"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/rose_500"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailClose"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
